<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <crontab>
            <stackgauge>
                <jobs>
                    <stacknuts_stackgauge_send_report>
                        <schedule>
                            <cron_expr>*/20 * * * *</cron_expr>
                        </schedule>
                    </stacknuts_stackgauge_send_report>
                    <stacknuts_stackgauge_send_heartbeat>
                        <schedule>
                            <cron_expr>*/5 * * * *</cron_expr>
                        </schedule>
                    </stacknuts_stackgauge_send_heartbeat>
                    <stacknuts_stackgauge_send_daily_report>
                        <schedule>
                            <cron_expr>0 0 * * *</cron_expr>
                        </schedule>
                    </stacknuts_stackgauge_send_daily_report>
                    <stacknuts_stackgauge_send_daily_report_slot_1>
                        <schedule>
                            <cron_expr>0 1 * * *</cron_expr>
                        </schedule>
                    </stacknuts_stackgauge_send_daily_report_slot_1>
                    <stacknuts_stackgauge_send_config_sync>
                        <schedule>
                            <cron_expr>30 2 * * *</cron_expr>
                        </schedule>
                    </stacknuts_stackgauge_send_config_sync>
                </jobs>
            </stackgauge>
        </crontab>
        <stacknuts_stackgauge>
            <cadence>
                <hourly_slots>3</hourly_slots>
                <daily_slots>2</daily_slots>
            </cadence>
            <general>
                <enabled>0</enabled>
                <self_probe_enabled>1</self_probe_enabled>
                <!-- No default here is deliberate: Model\Config::getDisabledReporterCodes() treats
                an empty "disabled_reporters" as "disable nothing", so an unset value already
                means every reporter in ReporterList::CODES runs - including any added by a
                future module update, with no default to keep in sync here. -->
                <additional_log_files><![CDATA[{"_1000000000000_001":{"name":"System Log","file":"system.log"},"_1000000000000_002":{"name":"Exception Log","file":"exception.log"}}]]></additional_log_files>
            </general>
            <log>
                <log_level>300</log_level>
            </log>
        </stacknuts_stackgauge>
    </default>
</config>
