<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/cron_groups.xsd">
    <group id="stackgauge">
        <!--
            ahead_for=10 (5x the 5-minute heartbeat's own period, comfortably more than
            generate_every) guarantees every schedule-generation run overlaps the previous
            one's window - a short ahead_for window can miss the hourly send_report job
            entirely on real system cron, which isn't aligned to the hour boundary.
        -->
        <schedule_generate_every>5</schedule_generate_every>
        <schedule_ahead_for>10</schedule_ahead_for>
        <schedule_lifetime>15</schedule_lifetime>
        <history_cleanup_every>10</history_cleanup_every>
        <!--
            180 minutes (3 hourly cycles), not the default group's 60 - CronReporter reads
            "last successful run per job" from this history, and a 60-minute lifetime would
            purge the hourly job's last success right before the next run, making the site
            look like cron had died when it hadn't.
        -->
        <history_success_lifetime>180</history_success_lifetime>
        <history_failure_lifetime>600</history_failure_lifetime>
        <use_separate_process>0</use_separate_process>
    </group>
</config>
